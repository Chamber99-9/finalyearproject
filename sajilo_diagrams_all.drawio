        <mxCell id="ll_api" value="FastAPI Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="440" y="40" width="130" height="880" as="geometry" /></mxCell>
        <mxCell id="ll_db" value="MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="120" height="880" as="geometry" /></mxCell>
        <mxCell id="ll_off" value="Loan Officer" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="40" width="120" height="880" as="geometry" /></mxCell>
        <mxCell id="ll_gw" value="eSewa / Khalti" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1040" y="40" width="120" height="880" as="geometry" /></mxCell>
        <mxCell id="m1" value="1: Submit KYC" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;exitX=1;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="ll_c" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="120" as="sourcePoint" /><mxPoint x="505" y="120" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2: kyc_status = pending" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="160" as="sourcePoint" /><mxPoint x="700" y="160" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="3: Approve KYC (verify)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_off" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="200" as="sourcePoint" /><mxPoint x="505" y="200" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="4: kyc_status = verified" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="240" as="sourcePoint" /><mxPoint x="700" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="5: Upload document" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_c" target="ll_bff"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="300" as="sourcePoint" /><mxPoint x="300" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="6: POST /documents (OCR + classify)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_bff" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="340" as="sourcePoint" /><mxPoint x="505" y="340" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="7: mismatch -&gt; &quot;Doesnot look like required document&quot; / else save + detected fields" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_bff"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="380" as="sourcePoint" /><mxPoint x="300" y="380" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m8" value="8: Submit application" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_c" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="440" as="sourcePoint" /><mxPoint x="505" y="440" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="9: KYC gate + salary cap + collateral docs -&gt; submitted" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="480" as="sourcePoint" /><mxPoint x="700" y="480" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="10: Approve" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_off" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="520" as="sourcePoint" /><mxPoint x="505" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="11: create loan_account (disburse)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="560" as="sourcePoint" /><mxPoint x="700" y="560" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="12: Pay EMI (qr | khalti)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_c" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="640" as="sourcePoint" /><mxPoint x="505" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="13: [Khalti] initiate + lookup Completed" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_gw"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="680" as="sourcePoint" /><mxPoint x="1100" y="680" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="14: [QR] scan &amp; pay merchant" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_c" target="ll_gw"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="720" as="sourcePoint" /><mxPoint x="1100" y="720" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m15" value="15: [QR] Officer confirms received" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_off" target="ll_api"><mxGeometry relative="1" as="geometry"><mxPoint x="900" y="760" as="sourcePoint" /><mxPoint x="505" y="760" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="16: settle - reduce outstanding, advance due" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_db"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="800" as="sourcePoint" /><mxPoint x="700" y="800" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="17: receipt" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;" edge="1" parent="1" source="ll_api" target="ll_c"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="840" as="sourcePoint" /><mxPoint x="100" y="840" as="targetPoint" /></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
