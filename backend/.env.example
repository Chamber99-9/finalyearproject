APP_NAME=Sajilo Loan API
APP_ENV=development
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sajilo_loan
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=sajilo-loan-api
JWT_AUDIENCE=sajilo-loan-users
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_COUNT=20
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
