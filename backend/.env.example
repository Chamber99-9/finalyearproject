APP_NAME=Sajilo Loan API
APP_ENV=development
API_PREFIX=/api
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sajilo_loan
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=sajilo-loan-api
JWT_AUDIENCE=sajilo-loan-users
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_RATE_LIMIT_COUNT=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
EXPENSIVE_RATE_LIMIT_COUNT=20
EXPENSIVE_RATE_LIMIT_WINDOW_SECONDS=60
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Email (real delivery) --------------------------------------------------
# When SMTP_HOST is set, OTPs, EMI reminders, and notifications are sent as real
# email. Leave SMTP_HOST empty to fall back to the simulated logger (no mail).
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Google Account > Security > App passwords > generate one for "Mail".
#   3. Put the 16-character app password in SMTP_PASSWORD (remove spaces).
#   4. Set SMTP_USER and EMAIL_FROM to that Gmail address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-address@gmail.com

# --- Payments ---------------------------------------------------------------
# Rail used for EMI payments:
#   "esewa" — default; real eSewa UAT gateway (needs a reachable return URL / ngrok).
#   "khalti" — Khalti sandbox (needs a test secret key).
#   "qr" — scan a QR, officer confirms the receipt.
#   "mock" — DEMO MODE: settles instantly and shows the receipt + emails it, with
#            no external gateway. Use this for a guaranteed localhost demo/defense.
PAYMENT_PROVIDER=esewa
# Khalti sandbox: get a TEST secret key from a Khalti test-merchant account
# (https://test-admin.khalti.com). Leave blank to disable Khalti. Sandbox base
# URL is https://dev.khalti.com/api/v2 (already the default).
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
# eSewa ePay v2 (UAT test merchant works out of the box).
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# On localhost the gateway can only redirect back if this URL is reachable.
# Use http://localhost:3000, or a public tunnel (ngrok) for a real gateway test.
PAYMENT_RETURN_URL_BASE=http://localhost:3000

# --- EMI reminders ----------------------------------------------------------
# Email customers this many days before each EMI due date.
REMINDER_DAYS_BEFORE=7
# Background auto-sender: on = mail goes out without an admin action.
REMINDER_SCHEDULER_ENABLED=true
REMINDER_SCHEDULER_INTERVAL_HOURS=12
